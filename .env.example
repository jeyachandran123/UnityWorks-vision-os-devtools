
# --- Live CCTV (Phase 7) -------------------------------------------------
# VIDEO_SOURCE=file keeps recorded replay; rtsp switches to live cameras.
VIDEO_SOURCE=file
CCTV_HOST=gayatri.freemyip.com
CCTV_RTSP_PORT=554
# Explicit allowlist. Empty selects NOTHING — a 16-channel DVR must not
# become 16 pipelines by default. Set the 5-7 kitchen channels here.
CCTV_CHANNELS=
CCTV_STREAM_TYPE=sub
CCTV_ANALYSIS_FPS=4.0
# Credentials come from the environment and are never committed.
# The DVR password is not available yet; a camera without one reports
# CREDENTIALS_MISSING and declines to dial.
CCTV_USERNAME=admin
CCTV_PASSWORD=99999999@
