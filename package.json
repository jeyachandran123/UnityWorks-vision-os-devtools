{
  "name": "vision-os-validation-console",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Engineering Validation System for UnityWorks Vision OS v1. Standalone. Read-only. Speaks REST/WebSocket only.",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:component": "vitest run tests/component",
    "test:integration": "vitest run tests/integration",
    "test:replay": "vitest run tests/replay",
    "test:ui": "vitest run tests/ui",
    "test:websocket": "vitest run tests/websocket",
    "test:performance": "vitest run tests/performance",
    "test:regression": "vitest run tests/regression",
    "test:architecture": "vitest run tests/architecture",
    "coverage": "vitest run --coverage",
    "verify": "npm run typecheck && npm run test"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^6.4.0",
    "@mui/material": "^6.4.0",
    "@mui/x-data-grid": "^7.24.0",
    "@tanstack/react-query": "^5.64.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.17.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
